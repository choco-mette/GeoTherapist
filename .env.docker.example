# Port expose on host machine
APP_PORT=8000

# App Settings
APP_NAME=TerapisTracker
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

# Database (Default: SQLite persistent inside container volume)
DB_CONNECTION=sqlite
DB_DATABASE=/app/database/database.sqlite

# If connecting to external MySQL/MariaDB or PostgreSQL:
# DB_CONNECTION=mysql
# DB_HOST=db.example.com
# DB_PORT=3306
# DB_DATABASE=terapis_tracker
# DB_USERNAME=root
# DB_PASSWORD=secret

# Drivers
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# Auto run migrations on start (true / false)
AUTO_MIGRATE=true
